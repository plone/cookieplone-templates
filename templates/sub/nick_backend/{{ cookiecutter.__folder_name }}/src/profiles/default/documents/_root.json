{
  "uuid": "92a80817-f5b7-400d-8f58-b08126f0f09b",
  "type": "Site",
  "title": "Welcome to Plone Aurora!",
  "description": "Congratulations! You have successfully installed Plone Aurora.",
  "owner": "admin",
