{
  "name": "{{ cookiecutter.npm_package_name }}",
  "description": "{{ cookiecutter.description }}",
  "type": "module",
  "license": "MIT",
  "version": "0.0.1",
  "private": true,
  "keywords": [
    "cms"
  ],
  "author": "{{ cookiecutter.author }} <{{ cookiecutter.email }}>",
  "homepage": "https://github.com/{{ cookiecutter.github_organization }}/{{ cookiecutter.project_slug }}",
  "repository": {
    "type": "git",
    "url": "git@github.com:{{ cookiecutter.github_organization }}/{{ cookiecutter.project_slug }}.git"
  },
  "scripts": {
    "develop": "mkdir -p src && missdev --config=tsconfig.json --fetch-https",
    "bootstrap": "pnpm install && pnpm migrate",
    "i18n": "tsx src/develop/nick/scripts/i18n.ts",
    "i18n:ci": "pnpm i18n && git diff -G'^[^\\\"POT]' --exit-code",
    "lint": "./node_modules/eslint/bin/eslint.js --max-warnings=0 --no-error-on-unmatched-pattern 'packages/*/src/**/*.{js,jsx,ts,tsx}'",
    "migrate": "nick --modules=migrate",
    "nick": "nick",
    "prettier": "./node_modules/.bin/prettier --single-quote --check 'packages/*/src/**/*.{js,jsx,ts,tsx,json}'",
    "seed:status": "tsx src/develop/nick/scripts/seed.ts status",
    "start": "nodemon --watch packages --watch config.ts --ext ts,json --exec 'nick'",
    "test": "AUTH_RATE_LIMIT=1000 vitest run --dir ./packages --passWithNoTests"
  },
  "engines": {
    "node": "^22 || ^24 || ^25 || ^26"
  },
  "devDependencies": {
    "@babel/core": "7.29.0",
    "@babel/plugin-transform-typescript": "7.28.6",
    "@eslint/eslintrc": "3.3.3",
    "@eslint/js": "10.0.1",
    "@types/express": "5.0.6",
    "@types/jsonwebtoken": "9.0.10",
    "@types/mime-types": "3.0.1",
    "@types/node": "25.3.0",
    "@types/nodemailer": "7.0.11",
    "@types/pdf-parse": "1.1.5",
    "@types/supertest": "6.0.3",
    "@vitest/ui": "4.0.18",
    "eslint": "10.0.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-json": "4.0.1",
    "eslint-plugin-prettier": "5.5.5",
    "glob": "13.0.6",
    "pofile": "1.1.4",
    "prettier": "3.8.1",
    "supertest": "7.2.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.66.0",
    "vitest": "4.0.18"
  },
  "dependencies": {
    "@plone/nick": "workspace:^",
    "{{ cookiecutter.backend_addon_name }}": "workspace:*",
    "nodemon": "3.1.14",
    "tsx": "4.21.0"
  },
  "packageManager": "pnpm@10.20.0"
}
