{
  "name": "{{ cookiecutter.__npm_package_name }}-dev",
  "private": true,
  "version": "{{ cookiecutter.__version_package }}",
  "description": "{{ cookiecutter.description }}",
  "author": "{{ cookiecutter.author }}",
  "homepage": "https://github.com/{{ cookiecutter.github_organization }}/{{ cookiecutter.frontend_addon_name }}",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "aurora",
    "plone",
    "react"
  ],
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "dev": "react-router dev",
    "start": "react-router dev",
    "build": "react-router build",
    "start:prod": "node server.js ./build/server/index.js",
    "typecheck": "react-router typegen && tsc",
    "i18n": "pnpm --filter {{ cookiecutter.__npm_package_name }} i18n",
    "test": "pnpm --filter {{ cookiecutter.__npm_package_name }} exec vitest --passWithNoTests",
    "lint": "eslint --max-warnings=0 'packages/**/*.{js,jsx,ts,tsx}'",
    "lint:fix": "eslint --fix 'packages/**/*.{js,jsx,ts,tsx}'",
    "prettier": "prettier --check 'packages/**/*.{js,jsx,ts,tsx}'",
    "prettier:fix": "prettier --write 'packages/**/*.{js,jsx,ts,tsx}' ",
    "stylelint": "stylelint 'packages/**/*.{css,scss,less}' --allow-empty-input",
    "stylelint:fix": "stylelint 'packages/**/*.{css,scss,less}' --fix --allow-empty-input",
    "dry-release": "pnpm --filter {{ cookiecutter.__npm_package_name }} dry-release",
    "release": "pnpm --filter {{ cookiecutter.__npm_package_name }} release",
    "release-major-alpha": "pnpm --filter {{ cookiecutter.__npm_package_name }} release-major-alpha",
    "release-alpha": "pnpm --filter {{ cookiecutter.__npm_package_name }} release-alpha",
    "test:acceptance": "playwright test",
    "test:acceptance:ui": "playwright test --ui"
  },
  "dependencies": {
    "@plone/aurora": "{{ cookiecutter.aurora_version }}",
    "{{ cookiecutter.__npm_package_name }}": "workspace:*",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-router": "catalog:"
  },
  "devDependencies": {
    "@axe-core/playwright": "catalog:",
    "@playwright/test": "catalog:",
    "@react-router/dev": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "axe-core": "catalog:",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "eslint-plugin-jsx-a11y": "catalog:",
    "eslint-plugin-react": "catalog:",
    "eslint-plugin-react-hooks": "catalog:",
    "globals": "catalog:",
    "playwright": "catalog:",
    "prettier": "catalog:",
    "stylelint": "catalog:",
    "stylelint-config-idiomatic-order": "catalog:",
    "stylelint-prettier": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vite": "catalog:"
  },
  "packageManager": "pnpm@{{ versions.frontend_aurora_pnpm }}"
}
